# ==============================================================================
# VARELLION Frontend - Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
.pnp/
.pnp.js
.pnp.cjs

# Next.js build and output directories
.next/
out/
build/
dist/

# Testing and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Environment variables
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Keep documented environment templates available
!.env.example
!.env.*.example

# Logs and package-manager debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime and caches
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Generated TypeScript declaration
next-env.d.ts

# IDE and editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# Security files and certificates
*.pem
*.key
*.p12
*.pfx

# Deployment and hosting
.vercel/

# Local references and cache directories
_references/
