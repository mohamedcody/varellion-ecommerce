# ==============================================================================
# VARELLION Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API Base URL (Spring Boot 3.3.4 running locally or in production)
# Note: Do NOT append /v1 — endpoints are mapped to /api/...
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Google OAuth 2.0 Client ID (Public Browser-Visible Identifier)
# Must match backend google.oauth.client-id and Google Cloud Console authorized javascript origins
# SECURITY NOTE: Never put client_secret in frontend environment files!
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1003559537454-c93rrfj1ka0pjabj10g02eado3c9r2jg.apps.googleusercontent.com

# Mock API Toggle (true = mock catalog fixtures; false = real backend catalog)
NEXT_PUBLIC_USE_MOCK_API=false
