# ==============================================================================
# VARELLION Backend Production Environment Template (.env.production)
# Target Deployment: Hostinger VPS
# Instructions: Copy this file to .env on your VPS and populate actual values.
# NEVER commit real secret values to Git.
# ==============================================================================

# Server Runtime Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection
# Recommended for VPS HikariCP: Transaction Pooler (port 6543) or Session Pooler (port 5432)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://<SUPABASE_HOST>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.<YOUR_SUPABASE_PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=<YOUR_SUPABASE_DATABASE_PASSWORD>

# ------------------------------------------------------------------------------
# Security & JWT Token Authentication
# Generate a cryptographically secure 256-bit+ Base64 key: openssl rand -base64 64
# ------------------------------------------------------------------------------
JWT_SECRET=<YOUR_BASE64_256BIT_SECRET_KEY>
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ------------------------------------------------------------------------------
# CORS & Frontend Origins
# Comma-separated list of authorized storefront domains (without trailing slashes)
# ------------------------------------------------------------------------------
FRONTEND_URL=https://varellion.luxury,https://www.varellion.luxury
CORS_ALLOWED_ORIGINS=https://varellion.luxury,https://www.varellion.luxury

# Cookie Security (Must be true for HTTPS production)
COOKIE_SECURE=true
# Use 'Lax' if frontend and api share same root domain (e.g., varellion.com & api.varellion.com)
# Use 'None' if frontend and api are hosted on completely different domains (requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=Lax

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Integration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>.apps.googleusercontent.com

# Authorized Administrator Emails (Comma-separated for administrative RBAC)
ADMIN_EMAILS=admin@varellion.luxury

# ------------------------------------------------------------------------------
# Proxy & Network Security
# Trusted proxy CIDR/IPs for RateLimiting client IP resolution (Docker bridge subnet)
# ------------------------------------------------------------------------------
APP_TRUSTED_PROXIES=127.0.0.1,::1,172.28.0.10/32

# ------------------------------------------------------------------------------
# Store Business Policies
# ------------------------------------------------------------------------------
STORE_CURRENCY=EGP
ORDER_RESERVATION_HOURS=24
LOW_STOCK_THRESHOLD=5
