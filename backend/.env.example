# ==============================================================================
# VARELLION Accessories Backend Environment Configuration Example
# Copy this file to .env or export variables in your runtime environment.
# DO NOT COMMIT REAL SECRETS TO GIT.
# ==============================================================================

# Server configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Connection
# Host: aws-0-eu-west-1.pooler.supabase.com
# Port: 6543 (Transaction Pooler) or 5432 (Session Pooler)
# Database: postgres
# User: postgres.zninhofysyaydtumidvy
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.zninhofysyaydtumidvy
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Supabase Auth / JWT Configuration
SUPABASE_PROJECT_REF=zninhofysyaydtumidvy
SUPABASE_URL=https://zninhofysyaydtumidvy.supabase.co
SUPABASE_JWT_ISSUER=https://zninhofysyaydtumidvy.supabase.co/auth/v1
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_JWK_SET_URI=https://zninhofysyaydtumidvy.supabase.co/auth/v1/.well-known/jwks.json

# Approved Administrator Emails (Comma-separated for Google OAuth allowlist)
ADMIN_EMAILS=admin@varellion.com

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Store Settings
STORE_CURRENCY=EGP
ORDER_RESERVATION_HOURS=24
LOW_STOCK_THRESHOLD=5
