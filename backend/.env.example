# ==============================================================================
# VARELLION Accessories Backend Environment Configuration Example
# Copy this file to .env or export variables in your runtime environment.
# DO NOT COMMIT REAL SECRETS TO GIT.
# ==============================================================================

# Server configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Connection
# Host: aws-0-eu-west-1.pooler.supabase.com
# Port: 6543 (Transaction Pooler — ALWAYS keep prepareThreshold=0) or 5432 (Session Pooler)
# Database: postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
# Dedicated Session Pooler (:5432) or Direct URL for Flyway advisory locks (AUD-012)
SPRING_FLYWAY_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# JWT & Google OAuth Configuration (REQUIRED — no defaults in production)
JWT_SECRET=REPLACE_WITH_STRONG_BASE64_256BIT_SECRET
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Approved Administrator Emails (Comma-separated for Google OAuth allowlist; empty by default)
ADMIN_EMAILS=

# Security, CORS, Cookies & Trusted Reverse Proxy
FRONTEND_URL=https://varellion.com
COOKIE_SECURE=true
APP_TRUSTED_PROXIES=127.0.0.1,::1,172.28.0.10/32

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Store Settings
STORE_CURRENCY=EGP
ORDER_RESERVATION_HOURS=24
LOW_STOCK_THRESHOLD=5
