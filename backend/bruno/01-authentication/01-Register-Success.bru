meta {
  name: 01. Register - Valid User (Happy Path)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{dynUsername}}",
    "email": "{{dynEmail}}",
    "password": "{{testPassword}}"
  }
}

vars:pre-request {
  dynUsername: user_admin
  dynEmail: user_admin@gmail.com
  testPassword: 123456789
}

assert {
  res.status: eq 200
  res.body.accessToken: isDefined
  res.body.refreshToken: isUndefined
  res.body.role: eq USER
  res.body.message: eq Registration successful
}

script:pre-request {
  const ts = Date.now();
  bru.setVar("dynUsername", "user_" + ts);
  bru.setVar("dynEmail", "user_" + ts + "@varellion.com");
}

script:post-response {
  if (res.status === 200) {
    if (res.body.accessToken) {
      bru.setEnvVar("accessToken", res.body.accessToken);
    }
  }
}
