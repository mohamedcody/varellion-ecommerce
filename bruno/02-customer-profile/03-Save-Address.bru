meta {
  name: 03. Save or Update Delivery Address (Upsert)
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/customer/address
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "governorate": "القاهرة",
    "cityArea": "مدينة نصر",
    "detailedAddress": "شارع عباس العقاد، عمارة 15، الدور الرابع"
  }
}

vars:pre-request {
  accessToken: eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c2VyXzE3OTM5MDcwMzY5MjRAdmFyZWxsaW9uLmNvbSIsInRva2VuX3R5cGUiOiJBQ0NFU1MiLCJpYXQiOjE3OTM5MDcwMzgsImV4cCI6MTc5MzkwNzkzOH0.G-FRO7VJAo98fW7RTdRClUL72mq8idrLFukmaXvAyZo
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.governorate: eq "القاهرة"
  res.body.data.cityArea: eq "مدينة نصر"
}
