meta {
  name: 02. Update Customer Profile (Name & Phone)
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/customer/profile
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "fullName": "محمد سعد عبد الله احمد",
    "phoneNumber": "01012345678",
      "address":"حاره الحمايده",
  }
}

vars:pre-request {
  accessToken: eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c2VyXzE3OTQ4MzU3NjA5MDlAdmFyZWxsaW9uLmNvbSIsInRva2VuX3R5cGUiOiJBQ0NFU1MiLCJpYXQiOjE3OTQ4MzU3NjQsImV4cCI6MTc5NDgzNjY2NH0.Z6wkO7Y_kS-NkEzsgps6lDqSgNMPn2MzQB0DiyXMY7s
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.fullName: eq "محمد سعد"
  res.body.data.phoneNumber: eq "01012345678"
}
