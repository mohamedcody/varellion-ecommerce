meta {
  name: 01. Get Customer Profile & Address
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/customer/profile
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  accessToken: eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c2VyXzE3OTM5MDcwMzY5MjRAdmFyZWxsaW9uLmNvbSIsInRva2VuX3R5cGUiOiJBQ0NFU1MiLCJpYXQiOjE3OTM5MDcwMzgsImV4cCI6MTc5MzkwNzkzOH0.G-FRO7VJAo98fW7RTdRClUL72mq8idrLFukmaXvAyZo
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.username: isDefined
  res.body.data.userId: isDefined
}
