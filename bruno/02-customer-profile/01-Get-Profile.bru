meta {
  name: 01. Get Customer Profile & Address
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/customer/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.username: isDefined
  res.body.data.userId: isDefined
}
