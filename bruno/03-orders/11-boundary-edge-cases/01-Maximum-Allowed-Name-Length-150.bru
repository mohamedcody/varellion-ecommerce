meta {
  name: 01. Maximum Allowed Customer Name Length (150 Chars)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: BOUNDARY-NAME-{{$timestamp}}
}

body:json {
  {
    "customerName": "عبد الرحمن محمد أحمد محمود مصطفى الشناوي الحسيني السكندري الفاخر ذو الفضل والإحسان والهمة العالية رضي الله عنه وأرضاه في كل وقت وحين من كبار عملاء متجر فارليون",
    "customerPhone": "01012345678",
    "shippingGovernorate": "القاهرة",
    "shippingCityArea": "المعادي",
    "shippingDetailedAddress": "شارع النصر عمارة 15",
    "paymentMethod": "CASH_ON_DELIVERY",
    "items": [
      {
        "productId": "{{productIdCardholder}}",
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.orderNumber: isDefined
}

docs {
  # 01. Maximum Allowed Customer Name Length (150 Chars)
  
  ### 1. Objective:
  Verify customer name boundary at the `VARCHAR(150)` database column limit. Validates that full Arabic compound names within 150 characters are accepted and saved without truncation.
}
