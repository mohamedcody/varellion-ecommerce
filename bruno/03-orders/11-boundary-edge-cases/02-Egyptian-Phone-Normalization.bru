meta {
  name: 02. Egyptian Phone Normalization (+20 Prefix)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: PHONE-NORM-{{$timestamp}}
}

body:json {
  {
    "customerName": "أحمد فوزي",
    "customerPhone": "+20 10 1234 5678",
    "shippingGovernorate": "القاهرة",
    "shippingCityArea": "المعادي",
    "shippingDetailedAddress": "شارع النصر عمارة 15",
    "paymentMethod": "CASH_ON_DELIVERY",
    "items": [
      {
        "productId": "{{productIdCardholder}}",
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.customerPhone: eq "01012345678"
}

docs {
  # 02. Egyptian Phone Normalization (+20 Prefix)
  
  ### 1. Objective:
  Verify Egyptian phone normalization:
  Input `"+20 10 1234 5678"` is stripped of non-digit characters and transformed into standardized local mobile format `"01012345678"`.
}
