meta {
  name: 03. Alexandria Shipping Rate (60 EGP)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: SHIP-ALEX-{{$timestamp}}
}

body:json {
  {
    "customerName": "أحمد فوزي",
    "customerPhone": "01012345678",
    "shippingGovernorate": "الإسكندرية",
    "shippingCityArea": "محطة الرمل",
    "shippingDetailedAddress": "ميدان سعد زغلول",
    "paymentMethod": "CASH_ON_DELIVERY",
    "items": [
      {
        "productId": "{{productIdCardholder}}",
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.data.shippingGovernorate: eq "الإسكندرية"
  res.body.data.shippingFee: eq 60.00
  res.body.data.totalAmount: eq 950.00
}

docs {
  # 03. Alexandria Shipping Rate (60 EGP)
  
  ### 1. Objective:
  Verify Tier 2 shipping rate (60.00 EGP) for Alexandria & Matrouh governorates.
}
