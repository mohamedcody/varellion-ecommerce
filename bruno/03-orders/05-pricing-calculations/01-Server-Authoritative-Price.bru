meta {
  name: 01. Server Authoritative Price Verification
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: AUTH-PRICE-{{$timestamp}}
}

body:json {
  {
    "customerName": "أحمد فوزي",
    "customerPhone": "01012345678",
    "shippingGovernorate": "القاهرة",
    "shippingCityArea": "المعادي",
    "shippingDetailedAddress": "شارع النصر عمارة 15",
    "paymentMethod": "CASH_ON_DELIVERY",
    "items": [
      {
        "productId": "{{productIdCardholder}}",
        "quantity": 1,
        "price": 5.00
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.subtotal: eq 890.00
  res.body.data.shippingFee: eq 50.00
  res.body.data.totalAmount: eq 940.00
  res.body.data.items[0].unitPrice: eq 890.00
}

docs {
  # 01. Server Authoritative Price Verification
  
  ### 1. Objective:
  Verify anti-tampering protection: Even if a malicious client injects `"price": 5.00` in the payload, the backend ignores it entirely and fetches the authoritative price (`890.00 EGP`) directly from the locked database record.
}
