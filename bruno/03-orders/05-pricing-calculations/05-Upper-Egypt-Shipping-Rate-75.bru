meta {
  name: 05. Upper Egypt Shipping Rate (75 EGP)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: SHIP-UPPER-{{$timestamp}}
}

body:json {
  {
    "customerName": "أحمد فوزي",
    "customerPhone": "01012345678",
    "shippingGovernorate": "أسيوط",
    "shippingCityArea": "حي شرق",
    "shippingDetailedAddress": "شارع الجمهورية",
    "paymentMethod": "CASH_ON_DELIVERY",
    "items": [
      {
        "productId": "{{productIdCardholder}}",
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.data.shippingGovernorate: eq "أسيوط"
  res.body.data.shippingFee: eq 75.00
  res.body.data.totalAmount: eq 965.00
}

docs {
  # 05. Upper Egypt Shipping Rate (75 EGP)
  
  ### 1. Objective:
  Verify Tier 4 shipping rate (75.00 EGP) for Northern Upper Egypt (Fayoum, Beni Suef, Minya, Asyut).
}
