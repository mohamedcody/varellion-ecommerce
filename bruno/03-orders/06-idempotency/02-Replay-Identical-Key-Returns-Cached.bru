meta {
  name: 02. Replay Identical Key Returns Cached Response
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: FIXED-IDEM-KEY-99999
}

body:json {
  {
    "customerName": "أحمد فوزي",
    "customerPhone": "01012345678",
    "shippingGovernorate": "القاهرة",
    "shippingCityArea": "المعادي",
    "shippingDetailedAddress": "شارع النصر عمارة 15",
    "paymentMethod": "CASH_ON_DELIVERY",
    "items": [
      {
        "productId": "{{productIdCardholder}}",
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.orderNumber: isDefined
}

docs {
  # 02. Replay Identical Key Returns Cached Response
  
  ### 1. Objective:
  Resending the exact same `Idempotency-Key: FIXED-IDEM-KEY-99999` must return HTTP `201 Created` with the cached `OrderResponseDto` immediately.
  
  ### 2. Critical Invariants:
  - NO second database row is inserted into `orders` or `order_items`.
  - NO additional stock is deducted or reserved.
  - Returns the same `orderNumber` as request 01.
}
