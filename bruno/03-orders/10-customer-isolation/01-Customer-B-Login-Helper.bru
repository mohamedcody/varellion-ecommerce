meta {
  name: 01. Login or Register Customer B (Isolation Setup)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  const ts = Date.now();
  bru.setVar("dynUserB", "user_b_" + ts);
  bru.setVar("dynEmailB", "user_b_" + ts + "@varellion.com");
}

body:json {
  {
    "username": "{{dynUserB}}",
    "email": "{{dynEmailB}}",
    "password": "{{testPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isDefined
}

script:post-response {
  if (res.status === 200 && res.body.accessToken) {
    bru.setEnvVar("accessTokenB", res.body.accessToken);
  }
}

docs {
  # 01. Login or Register Customer B (Isolation Setup)
  
  ### 1. Objective:
  Provisions a second distinct customer (Customer B) to test cross-customer data isolation and IDOR guards.
  Saves token into `{{accessTokenB}}`.
}
