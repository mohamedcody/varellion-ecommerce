meta {
  name: 02. Complete Order Creation and Public Tracking Smoke Test
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: SMOKE-TEST-{{$timestamp}}
}

body:json {
  {
    "customerName": "أحمد فوزي الشناوي",
    "customerPhone": "01012345678",
    "shippingGovernorate": "القاهرة",
    "shippingCityArea": "المعادي",
    "shippingDetailedAddress": "شارع النصر عمارة 15",
    "paymentMethod": "CASH_ON_DELIVERY",
    "items": [
      {
        "productId": "{{productIdWatch}}",
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.orderNumber: isDefined
  res.body.data.orderStatus: eq PENDING_CUSTOMER_CONFIRMATION
}

script:post-response {
  if (res.status === 201 && res.body.data) {
    bru.setEnvVar("smokeOrderNumber", res.body.data.orderNumber);
    bru.setEnvVar("smokeOrderPhone", res.body.data.customerPhone);
  }
}

docs {
  # 02. Complete Order Creation and Public Tracking Smoke Test
  
  ### 1. Objective:
  End-to-end smoke test validating the complete order placement lifecycle from authenticated submission to order number generation and customer phone storage.
}
