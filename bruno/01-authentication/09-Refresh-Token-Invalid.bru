meta {
  name: 09. Refresh Token - Security Test - Malformed Token
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "malformed.or.tampered.token.payload"
  }
}

assert {
  res.status: eq 401
  res.body.status: eq 401
  res.body.error: eq Unauthorized
}
