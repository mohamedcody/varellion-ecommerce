meta {
  name: 10. Logout User - Clear Session
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

assert {
  res.status: eq 200
  res.body.message: eq Logged out successfully
}

script:post-response {
  bru.setEnvVar("accessToken", "");
  bru.setEnvVar("refreshToken", "");
}
