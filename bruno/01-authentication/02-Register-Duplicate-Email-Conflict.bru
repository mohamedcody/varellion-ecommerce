meta {
  name: 02. Register - Duplicate Email Conflict
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "duplicate_user_probe",
    "email": "{{testEmail}}",
    "password": "{{testPassword}}"
  }
}

assert {
  res.status: eq 400
  res.body.status: eq 400
  res.body.error: eq Bad Request
  res.body.message: contains already registered
}
