meta {
  name: 04. Register - Validation - Invalid Email Format
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "bad_email_user",
    "email": "not-an-email-address",
    "password": "{{testPassword}}"
  }
}

assert {
  res.status: eq 400
  res.body.status: eq 400
  res.body.error: eq Validation Failed
  res.body.validationErrors.email: isDefined
}
