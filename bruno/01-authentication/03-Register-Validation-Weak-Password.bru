meta {
  name: 03. Register - Validation - Weak Password (<8 chars)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "weak_pwd_user",
    "email": "weak_pwd@varellion.com",
    "password": "123"
  }
}

assert {
  res.status: eq 400
  res.body.status: eq 400
  res.body.error: eq Validation Failed
  res.body.validationErrors.password: isDefined
}
