meta {
  name: 06. Login - Security Test - Invalid Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identifier": "{{testEmail}}",
    "password": "WrongPassword999!"
  }
}

assert {
  res.status: eq 401
  res.body.status: eq 401
  res.body.error: eq Unauthorized
  res.body.message: eq Invalid username or password
}
