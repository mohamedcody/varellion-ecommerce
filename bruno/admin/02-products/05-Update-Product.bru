meta {
  name: 05. Update Product Details
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/admin/products/{{createdAdminProductId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "categoryId": "{{categoryWatchId}}",
    "nameAr": "ديت جست ٣٦ روليكس",
    "nameEn": "ديت جست ٣٦ rolex",
    "descriptionAr": "ساعة فاخرة مصنوعة من الفولاذ المقاوم للصدأ وزجاج ياقوتي.",
    "descriptionEn": "Luxury stainless steel timepiece with sapphire crystal glass.",
    "price": 2850.00,
    "costPrice": 1300.00,
    "stockQuantity": 40,
    "sku": "VAR-BRU-WATCH-01114",
    "isActive": true,
    "images": [
      {
        "imageUrl": "https://media.rolex.com/image/upload/q_auto:eco/f_auto/t_v7-grid/c_limit,w_1920/v1/a677b2c664f6/catalogue/2026/upright-bba-with-shadow/m126300-0025",
        "isMain": true,
        "displayOrder": 0
      },
      {
        "imageUrl": "https://azzamwatches.com/cdn/shop/files/tr3j.jpg?v=1761769433&width=2000",
        "isMain": false,
        "displayOrder": 1
      },
      {
        "imageUrl": "https://timepiece360.com/cdn/shop/files/1_ff37122c-243c-44c4-a14c-f57f9efdd619_large.webp?v=1791624502",
        "isMain": false,
        "displayOrder": 2
      }
    ]
  }
}

vars:pre-request {
  adminAccessToken: eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c2VyXzE3OTQ4MzE3MDI5ODFAdmFyZWxsaW9uLmNvbSIsInRva2VuX3R5cGUiOiJBQ0NFU1MiLCJpYXQiOjE3OTQ4Mzc4NTksImV4cCI6MTc5NDgzODc1OX0.-Qdul3jtQ_Z9_OPyNVibhL_Fbp_x3CeYSdEngJvsXY0
  createdAdminProductId: 98788848-fcf3-492f-9dd1-e8c0f01bad1a
  categoryWatchId: 11111111-1111-1111-1111-111111111111
}

assert {
  res.status: eq 200
  res.body.productId: eq {{createdAdminProductId}}
  res.body.price: eq 3100.00
  res.body.stockQuantity: eq 50
  res.body.nameAr: contains إصدار برونو المحدث
}

docs {
  # 05. Update Product Details
  
  ### 1. الهدف:
  تحديث بيانات منتج قائم (الاسم، الوصف، الأسعار، المخزون، والصور).
  
  ### 2. التغييرات في قاعدة البيانات:
  - تحديث صفوف `products` بواسطة `productId`.
  - تحديث أو استبدال الصور في جدول `product_images`.
}
