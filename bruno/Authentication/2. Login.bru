meta {
  name: 2. Login User
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identifier": "mohamed_test@varellion.com",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.status === 200) {
    if (res.body.accessToken) {
      bru.setVar("accessToken", res.body.accessToken);
      bru.setEnvVar("accessToken", res.body.accessToken);
    }
    if (res.body.refreshToken) {
      bru.setVar("refreshToken", res.body.refreshToken);
      bru.setEnvVar("refreshToken", res.body.refreshToken);
    }
  }
}
